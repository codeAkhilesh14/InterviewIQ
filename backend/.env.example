# Server
PORT=8000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database
MONGODB_URL=

# Auth
JWT_SECRET=

# LLM provider - Groq (OpenAI-compatible API, genuine free tier)
GROQ_API_KEY=
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Retrieval
# Comma separated user agent string sent while crawling company sites
CRAWLER_USER_AGENT=InterviewIQBot/1.0 (+https://interviewiq.example.com/bot)
# Allow private/loopback hosts to be fetched - ONLY for local batch testing against
# a local fixture server (see Appendix B, company_url can be http://localhost:8099/...)
ALLOW_PRIVATE_HOSTS=false
